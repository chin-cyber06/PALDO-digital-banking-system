# Copy to .env for local development. On Vercel, set these in Project Settings > Environment Variables.

# true  = use mock services (no backend needed)
# false = call the real backend at NUXT_PUBLIC_API_BASE_URL
NUXT_PUBLIC_USE_MOCKS=true

# Backend base URL (used only when NUXT_PUBLIC_USE_MOCKS=false). No trailing slash.
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

NUXT_PUBLIC_APP_ENV=development
